# =============================================================================
# GIT IGNORE FOR RANCHER AIR-GAP DEPLOYMENT
# Prevents accidental commit of secrets, credentials, and sensitive files
# =============================================================================

# ---- CREDENTIALS & SECRETS (CRITICAL - DO NOT COMMIT) ----
# User configuration with credentials
config.tfvars
*.tfvars
*.tfvars.json
.tmp.*
**/.tmp.*
*.tmp

# Environment variables
.env
.env.local
.env.*.local
.env.vault

# Exceptions: keep template examples
!config.example.tfvars
!config.example*.tfvars
!terraform/config.tfvars

# ---- AWS & TERRAFORM STATE FILES (CRITICAL - DO NOT COMMIT) ----
# Terraform module cache & binaries
**/.terraform/
.terraform/
terraform/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
**/.terraform.tfstate.lock.info
.terraform.tfstate.lock.info

# Terraform lock files
.terraform.lock.hcl
**/.terraform.lock.hcl

# ---- SSH KEYS & CERTIFICATES (CRITICAL - DO NOT COMMIT) ----
*.pem
*.key
*.crt
*.cer
ssh-key.pem
id_rsa
id_rsa*
id_ed25519
id_ed25519*
id_ecdsa
id_ecdsa*
authorized_keys

# ---- DEPLOYMENT LOGS & STATE (Large/Sensitive) ----
logs/
*.log
.deploy-state
push-remaining-images.log
push-tier1.log

# ---- GENERATED CLUSTER FILES & ARCHIVES ----
kubeconfig
*.kubeconfig
rancher-images.tar.gz
*.tar.gz
*.tar
*.zip

# ---- OS FILES ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---- EDITOR & IDE FILES ----
.vscode/
.idea/
*.swp
*.swo
*~
.*.swp
.project
.classpath
.c9/
*.sublime-project
*.sublime-workspace

# ---- PYTHON ----
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# ---- NODE & NPM ----
node_modules/
npm-debug.log
yarn-error.log

# ---- MISC ----
*.bak
temp/
